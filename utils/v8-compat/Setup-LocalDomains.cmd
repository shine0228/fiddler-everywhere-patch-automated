@echo off
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $hostsFile=Join-Path $env:WINDIR 'System32\drivers\etc\hosts'; $raw=Get-Content -LiteralPath $hostsFile -Raw; $additions=@(); foreach($domain in @('api.getfiddler.be','identity.getfiddler.be')) { $lines=@($raw -split '\r?\n' | Where-Object { ($_ -split '#',2)[0] -match ('(^|\s)'+[Regex]::Escape($domain)+'(\s|$)') }); if($lines.Count -eq 0) { $additions+=('127.0.0.1 '+$domain) } elseif(@($lines | Where-Object { ($_ -split '\s+' | Where-Object { $_ })[0] -ne '127.0.0.1' }).Count -gt 0) { throw ('Conflicting mapping: '+$domain) } }; if($additions.Count -gt 0) { $backupDirectory=Join-Path $env:LOCALAPPDATA 'FiddlerEverywherePackageBackups'; New-Item -ItemType Directory -Path $backupDirectory -Force | Out-Null; $backup=Join-Path $backupDirectory ('hosts-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'.bak'); Copy-Item -LiteralPath $hostsFile -Destination $backup; [IO.File]::AppendAllText($hostsFile,([Environment]::NewLine+($additions -join [Environment]::NewLine)+[Environment]::NewLine),[Text.Encoding]::ASCII); Clear-DnsClientCache -ErrorAction SilentlyContinue; Write-Host ('Backup: '+$backup) }; Write-Host 'Local domain mappings are ready. You can open Fiddler Everywhere normally.'"
if errorlevel 1 echo Setup failed. Right-click this file and choose Run as administrator.
pause
